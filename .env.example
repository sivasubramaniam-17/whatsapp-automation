# ── Database (Postgres — Supabase/Neon free tier works) ──
DATABASE_URL="postgresql://user:password@localhost:5432/whatsapp_saas?schema=public"

# ── Auth ────────────────────────────────────────────────
# Long random string. Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ── WhatsApp Cloud API (Meta) ───────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
# In sandbox Meta gives a temporary token + test phone number id.
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v21.0"
WHATSAPP_ACCESS_TOKEN="your-temporary-or-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-test-phone-number-id"

# Webhook verify token — you invent this, then enter the SAME value in the
# Meta dashboard when subscribing the webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="my-verify-token-choose-anything"

# Meta app secret — used to validate webhook signatures (recommended).
WHATSAPP_APP_SECRET="your-meta-app-secret"

# ── Cron (drip sequences) — a secret the scheduler must send ──
CRON_SECRET="choose-any-random-string"

# ── Optional: OpenRouter LLM — smarter chatbot builder + lead scoring ──
# Everything works free without this (heuristics). Add a key to upgrade.
# Get a key at https://openrouter.ai/keys — free models are available.
OPENROUTER_API_KEY=""
# Free model (default). Free models change often — check https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
